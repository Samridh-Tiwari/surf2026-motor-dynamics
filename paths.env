# Copy to paths.local.env, edit, then:  source paths.local.env
# paths.local.env is ignored by git, so your own paths never get committed.
#
# Part A. Only LFADS_RUNS and RESULTS_DIR are needed to reproduce the figures
# from the committed checkpoints. The next three are for retraining from raw data.

export LFADS_RUNS=/path/to/lfads_runs/sweep_dyn      # per-animal cfg06 outputs
export RESULTS_DIR=./figures                          # where figures and JSON go
export ROBUST_DIR=./partA/results                     # robustness*.json live here

# Only needed if you have the raw data:
export SESSION_DATA=/path/to/MultiSessionData         # behavioural .mat per session
export STITCH_H5=/path/to/lfads_stitch_data.h5        # raw stitched spike archive
export BINNED_DIR=/path/to/lfads_sessions_20ms        # output of the rebin step

# Part B (MATLAB). Folder holding MouseM1/Day1, MouseM1/Day2, ...
# Read by partB/dataRoot.m. From MATLAB you can also run:
#   setenv('SURF_DATA_REALTIME', '/path/to/Data_Realtime')
export SURF_DATA_REALTIME=/path/to/Data_Realtime
